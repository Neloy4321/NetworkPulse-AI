# Example external TLS gateway, *only* with NETWORKPULSE_AUTH_MODE=oidc.
# Valid DNS, HTTPS certificates, issuer/audience/JWKS and platform firewall required.
{$NETWORKPULSE_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    reverse_proxy api:8000
}
