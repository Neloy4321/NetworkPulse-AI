{
  "id": null,
  "uid": "networkpulse-api",
  "title": "NetworkPulse — API & ML",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "15s",
  "tags": [
    "networkpulse",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(networkpulse_http_requests_total[5m]))",
          "legendFormat": "HTTP request rate"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(networkpulse_http_request_seconds_bucket[5m])))",
          "legendFormat": "HTTP p95 latency"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP error rate",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(networkpulse_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "HTTP error rate"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Flow ingestion rate",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(networkpulse_flow_ingest_total{result=\"inserted\"}[5m]))",
          "legendFormat": "Flow ingestion rate"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Detector p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(networkpulse_model_scoring_seconds_bucket[5m])))",
          "legendFormat": "Detector p95 latency"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alert updates per second",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(networkpulse_alert_updates_total[5m]))",
          "legendFormat": "Alert updates per second"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redis worker lag",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "networkpulse_stream_lag",
          "legendFormat": "Redis worker lag"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Redis pending acknowledgements",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "networkpulse_stream_pending",
          "legendFormat": "Redis pending acknowledgements"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Redis dead-letter depth",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "networkpulse_stream_dead_letter_depth",
          "legendFormat": "Redis dead-letter depth"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Redis metrics connectivity",
      "datasource": {
        "type": "prometheus",
        "uid": "networkpulse-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "networkpulse_stream_redis_reachable",
          "legendFormat": "Redis metrics connectivity"
        }
      ]
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
